# Generic OpenAI-compatible AI gateway. Fill these later when your personal
# base URL, API key and model name are available.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openrouter/free
AI_SITE_URL=http://localhost:8000
AI_APP_NAME=FinSight AI — Финансовый университет
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AUTO_AI=true

# OCR is used for image-only/scanned PDFs. The exact bundled RAS demo also has a pre-verified dataset.
# macOS: brew install tesseract tesseract-lang
ENABLE_OCR=true
OCR_VISUALS=false
OCR_LANGUAGE=rus+eng
OCR_DPI_SCALE=3.0
OCR_FORM_DPI_SCALE=3.5
OCR_TEXT_DPI_SCALE=2.8
OCR_PRIMARY_FORM_PAGES=14
OCR_MAX_PAGES=0
OCR_MIN_TEXT_CHARS=80
OCR_QUALITY_WARNING=62

MAX_UPLOAD_MB=100
MAX_AI_CHUNKS=1
AI_CHUNK_CHARS=50000
PORT=8000
