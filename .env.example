# Generic OpenAI-compatible AI gateway. Fill these later when your personal
# base URL, API key and model name are available.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openrouter/free
AI_SITE_URL=http://localhost:8000
AI_APP_NAME=FinSight AI — Финансовый университет
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AUTO_AI=true
ENABLE_VISION_RECOVERY=true
# Модель должна поддерживать изображения. Можно оставить пустым — тогда используется AI_MODEL.
VISION_MODEL=
# Максимум страниц основных форм для детальной визуальной транскрипции.
VISION_MAX_PAGES=12
# Сколько страниц длинного PDF просматривать через контактные листы.
VISION_LOCATOR_MAX_PAGES=180
VISION_CONTACT_SHEET_PAGES=12

# OCR is used for image-only/scanned PDFs. Demo and uploaded files use the same universal pipeline.
# macOS: brew install tesseract tesseract-lang
ENABLE_OCR=true
OCR_VISUALS=false
OCR_LANGUAGE=rus+eng
OCR_DPI_SCALE=3.0
OCR_FORM_DPI_SCALE=3.2
OCR_TEXT_DPI_SCALE=2.8
OCR_RETRY_DPI_SCALE=3.8
OCR_PRIMARY_FORM_PAGES=14
# 0 = scan all pages. Keep this value for reports whose forms may be on page 20+.
OCR_MAX_PAGES=0
OCR_MIN_TEXT_CHARS=80
OCR_QUALITY_WARNING=62

MAX_UPLOAD_MB=100
MAX_AI_CHUNKS=12
AI_CHUNK_CHARS=14000
PORT=8000
